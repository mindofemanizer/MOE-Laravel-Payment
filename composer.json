{
    "name": "moe/laravel-payment",
    "description": "MOE multi-gateway payment package for Laravel — Midtrans, Xendit, Stripe.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "MindOfEmanizer",
            "email": "mindofemanizer@users.noreply.github.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11 | ^12 | ^13",
        "illuminate/database": "^11 | ^12 | ^13",
        "illuminate/http": "^11 | ^12 | ^13"
    },
    "require-dev": {
        "pestphp/pest": "^3.0",
        "orchestra/testbench": "^8 | ^9 | ^10",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "Moe\\Payment\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Moe\\Payment\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Moe\\Payment\\PaymentServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/pest"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
